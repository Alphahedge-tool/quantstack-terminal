# Backend origin for the Vite dev proxy. Defaults to http://localhost:3101,
# which is where qt-backend binds (QT_BACKEND_PORT in the backend's own .env).
QT_BACKEND_URL=http://localhost:3101

# Overrides the API origin the browser calls directly, bypassing the proxy.
# Leave unset in dev (the proxy handles it) and in production (same-origin
# behind the reverse proxy). Set it only when the frontend is deployed to a
# different host than the API.
# VITE_API_BASE=https://api.example.com
