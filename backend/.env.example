# Credentials come from the Supabase `broker_accounts` table when these are set.
# A row is used for auto-login when `enabled` and `auto_login` are true and its
# `broker_env` matches NUBRA_ENV below (blank in the row counts as prod).
#
# SUPABASE_SERVICE_KEY bypasses row-level security — keep it server-side only.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Fallback for when Supabase is not configured or unreachable. Leave blank to
# sign in from the UI instead.
NUBRA_PHONE=
NUBRA_MPIN=
NUBRA_TOTP_SECRET=

# Runtime defaults
NUBRA_BASE_URL=https://api.nubra.io
NUBRA_ENV=prod
QT_FEEDS=nubra:1
QT_BACKEND_PORT=3101

# Performance and resilience tuning (optional)
QT_ROLLING_CONCURRENCY=4
QT_LIVE_THROTTLE_MS=250
QT_FEED_BREAKER_THRESHOLD=3
QT_FEED_BREAKER_COOLDOWN_MS=30000
QT_FEED_HEALTH_INTERVAL_MS=30000

# Live ticks require Python with nubra_python_sdk installed.
# QT_PYTHON=C:\path\to\python.exe
