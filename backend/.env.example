# Credentials come from the Supabase `broker_accounts` table when these are set.
# A row is used for auto-login when `enabled` and `auto_login` are true and its
# `broker_env` matches NUBRA_ENV below (blank in the row counts as prod).
#
# SUPABASE_SERVICE_KEY bypasses row-level security — keep it server-side only.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Fallback for when Supabase is not configured or unreachable. Leave blank to
# sign in from the UI instead.
NUBRA_PHONE=
NUBRA_MPIN=
NUBRA_TOTP_SECRET=

# Runtime defaults
NUBRA_BASE_URL=https://api.nubra.io
NUBRA_ENV=prod
QT_FEEDS=nubra:1
QT_BACKEND_PORT=3101

# The API binds 127.0.0.1 only. It holds a logged-in broker session and sets
# CORS to *, so exposing it puts order placement on the network unauthenticated.
# QT_BIND_HOST=0.0.0.0

# Performance and resilience tuning (optional)
QT_ROLLING_CONCURRENCY=4
QT_LIVE_THROTTLE_MS=250
QT_FEED_BREAKER_THRESHOLD=3
QT_FEED_BREAKER_COOLDOWN_MS=30000
QT_FEED_HEALTH_INTERVAL_MS=30000

# Live ticks require Python with nubra_python_sdk installed.
# QT_PYTHON=C:\path\to\python.exe

# Logging
#
# QT_LOG_LEVEL  trace | debug | info | warn | error | fatal
#               Default: debug outside production, info in it.
# QT_LOG_PRETTY 1 for the coloured single-line format a person reads,
#               0 for one JSON object per line, which is what a log shipper
#               wants. Unset follows the TTY: coloured at a terminal, JSON when
#               the output is piped to a file or a process manager.
QT_LOG_LEVEL=info
# QT_LOG_PRETTY=1

# Metrics
#
# The backend exposes Prometheus metrics at GET /metrics, always — there is no
# flag. A scrape endpoint that has to be enabled is one that turns out to be off
# on the day it is needed. It is on the same port as the API, so anything that
# can already reach the backend can scrape it; put it behind the same network
# boundary as /api.
#
# See ops/prometheus.yml for a scrape config covering all three processes.
