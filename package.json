{
  "name": "quantstack-ui",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "QuantStack Terminal — React + Vite frontend against the qt-backend service",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "node scripts/dev.mjs",
